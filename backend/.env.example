# Product Analyzer backend configuration
# Copy to .env and adjust as needed. All values have safe defaults.

# --- Server ---
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed origins (* = allow all)
CORS_ORIGINS=*

# --- Storage (relative to the backend/ directory) ---
DATA_DIR=data
UPLOAD_DIR_NAME=documents
PRODUCTS_DIR_NAME=products
